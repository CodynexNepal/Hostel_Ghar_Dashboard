NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_BACKEND_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Hostel Ghar
# Backend `paymentQrRouter` mount — frontend calls `${NEXT_PUBLIC_API_URL}<this>`.
# Default: /v1/hostel-ghar/payment-qrs (endpoints: / /resident /preview /demo /:id /:id/toggle)
# If your backend mounts elsewhere (e.g. /v1/payment-qr), set it here and restart `next dev`.
NEXT_PUBLIC_PAYMENT_QR_PATH=/v1/hostel-ghar/payment-qrs
# Hostel Ghar PLATFORM payment QRs (what owners scan to BUY a subscription).
# Option A (simplest): drop files in public/images/platform/ (esewa-qr.png, khalti-qr.png, bank-qr.png).
# Option B: override per-deploy with URLs below.
# NEXT_PUBLIC_PLATFORM_ESEWA_QR=https://example.com/hostel-ghar-esewa.png
# NEXT_PUBLIC_PLATFORM_KHALTI_QR=https://example.com/hostel-ghar-khalti.png
# NEXT_PUBLIC_PLATFORM_BANK_QR=https://example.com/hostel-ghar-bank.png
# NEXT_PUBLIC_PLATFORM_ESEWA_LABEL="eSewa ID: 98XXXXXXXX • Hostel Ghar"
# NEXT_PUBLIC_PLATFORM_KHALTI_LABEL="Khalti ID: 98XXXXXXXX • Hostel Ghar"
# NEXT_PUBLIC_PLATFORM_BANK_LABEL="Nabil Bank • A/C 0123456789 • Hostel Ghar Pvt. Ltd."
